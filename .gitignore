# ============================================================
# 注意：Git 只把「行首」的 # 当注释。
# 规则后面不能跟行尾注释，否则整行会被当成模式，静默失效。
# ============================================================

# --- 工具链与依赖（可重建，几百 MB）---

# JDK + Android SDK，约 1.2 GB
.toolchain/

# jsdom / sharp，npm install 可还原
tools/node_modules/

.npm-cache/

# --- 构建产物 ---

# aapt2 / d8 / javac 的中间输出
build/

# 打好的 APK
dist/

# 校验时解包的临时目录
.apk-check/

# --- 签名密钥（最重要）---
# 私钥一旦公开，任何人都能签出冒名 APK，且无法撤回。
# 要构建签名版请自备 keystore。
keystore/
*.jks
*.keystore

# --- 本地临时 / 工作文件 ---
# 开发过程中的截图（成品在 docs/screenshots/）
.shots/

# 截图用的 Electron 用户目录
.electron-userdata/

# 图标重做时的备份
.icon-backup/

*.log

# --- 编辑器 / 系统 ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.vscode/
.idea/
